# Environment variables
.env
.env.local
.env.development
.env.test
.env.production
.env.*  # Ignores any file starting with .env.

# Node.js
node_modules/
package-lock.json  # Optional, include if you use npm
yarn.lock          # Optional, include if you use Yarn
pnpm-lock.yaml     # Optional, include if you use pnpm

# Logs (restored specific patterns)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
build/
out/

# Dependency directories
bower_components/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.swp
*~

# Sensitive files
*.key
*.pem
*.cert
secrets.json
config.json

# Testing
coverage/
*.lcov